data cleaning. validation, and transformation
#########################

--removing duplicate/ data cleaning --
INSERT INTO silver.crm_prd_info (
    prd_id,
    cat_id,
    prd_key,
    prd_nm,
    prd_cost,
    prd_line,
    prd_start_dt,
    prd_end_dt
)
SELECT
    prd_id,
    REPLACE(SUBSTRING(prd_key, 1, 5), '-', '_') AS cat_id, --EXTRACT the first 5 characters and replace '-' with '_'
    SUBSTRING(prd_key, 7, LEN(prd_key)) AS prd_key,    --EXTRACT the characters after the 6th character
    prd_nm,
    ISNULL(prd_cost, 0) AS prd_cost,
    CASE 
        WHEN UPPER(TRIM(prd_line)) = 'M' THEN 'Mountain'
        WHEN UPPER(TRIM(prd_line)) = 'R' THEN 'Road'
        WHEN UPPER(TRIM(prd_line)) = 'T' THEN 'Touring'
        WHEN UPPER(TRIM(prd_line)) = 'S' THEN 'Other sales'
        ELSE 'n/a'
    END AS prd_line,  ---MAP the prd_line values to their corresponding descriptions
    CAST(prd_start_dt AS DATE) AS prd_start_dt, --Calculate end date as one day before the next start date for the same product, if available; otherwise, use a default end date (e.g., '9999-12-31')
    CAST(LEAD(prd_start_dt) OVER (PARTITION BY prd_key ORDER BY prd_start_dt) - 1 AS DATE) AS prd_end_dt
FROM bronze.crm_prd_info; --calcualte end date as one day before the next start date for the same product, if available; otherwise, use a default end date (e.g., '9999-12-31')







